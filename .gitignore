node_modules/
.wrangler/
*.log
Thumbs.db
desktop.ini

# .claude/ holds this machine's local tool settings (launch.json serves the
# app for testing). It is not part of the app.
.claude/

# VAPID private keys are generated by tools/vapid-keys.mjs and go straight
# into `wrangler secret put`. Never into the repo.
*.private.json
.dev.vars

# Android: www/ is copied from the shell by tools/build_www.mjs; never edit it.
www/

# Firebase config for the Android app (from the owner's Firebase project). Kept out of git;
# put it in android/app/ to build. The service account key lives outside the repo.
android/app/google-services.json
